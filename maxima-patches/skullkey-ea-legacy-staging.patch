+//! Older EA installers (EA Download Manager era) that never take the product
+//! key as an argument, and Touchup's harmless Game Explorer failure.
+//!
+//! * The EA app hands such installers their key through
+//!   `HKCU\Software\Electronic Arts\EA Core\Staging\eadm\eadm\online_content\<id>\ergc`
+//!   (default value, REG_SZ, the plain product key shown in the app). The
+//!   installer names its `<id>` in `autorun.dat`; nothing is written unless it
+//!   does, so no registry path is ever guessed.
+//! * Touchup ends with code 3 when Windows Game Explorer refuses to register
+//!   the game (`IGameExplorer2 … 80070005` under Wine). The game itself is
+//!   installed; only that registration failed.
+use std::{
+    io::{Read, Seek, SeekFrom},
+    path::{Path, PathBuf},
+};
+
+use log::{info, warn};
+
+use crate::util::native::{NativeError, WineError};
+
+// Path separators vary between installers; both are accepted.
+const STAGING_MARKERS: [&str; 2] = ["online_content\\", "online_content/"];
+const MAX_SCAN: u64 = 8 * 1024 * 1024;
+const MAX_LOG: u64 = 1024 * 1024;
+
+fn child_named(dir: &Path, name: &str) -> Option<PathBuf> {
+    std::fs::read_dir(dir).ok()?.flatten()
+        .map(|e| e.path())
+        .find(|p| p.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.eq_ignore_ascii_case(name)))
+}
+
+fn autorun_files(install_path: &Path) -> Vec<PathBuf> {
+    let Some(installer) = child_named(install_path, "__Installer") else { return vec![] };
+    let mut out = Vec::new();
+    let mut dirs = vec![(installer, 0)];
+    while let Some((dir, depth)) = dirs.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else { continue };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let Ok(kind) = entry.file_type() else { continue };
+            if kind.is_dir() && depth < 3 {
+                dirs.push((path, depth + 1));
+            } else if kind.is_file()
+                && path.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.eq_ignore_ascii_case("autorun.dat"))
+            {
+                out.push(path);
+            }
+        }
+    }
+    out.sort();
+    out
+}
+
+fn ids_in(text: &str) -> Vec<String> {
+    let lower = text.to_ascii_lowercase();
+    let mut ids = Vec::new();
+    let mut from = 0;
+    while let Some((at, marker)) = STAGING_MARKERS.iter()
+        .filter_map(|m| lower[from..].find(m).map(|at| (at, *m)))
+        .min_by_key(|(at, _)| *at)
+    {
+        let start = from + at + marker.len();
+        let id: String = text[start..].chars()
+            .take_while(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '-' | '.'))
+            .take(65).collect();
+        if !id.is_empty() && id.len() <= 64 && !ids.contains(&id) {
+            ids.push(id);
+        }
+        from = start;
+    }
+    ids
+}
+
+/// The staging id an installer reads its key from, if its `autorun.dat`
+/// names exactly one (read as ASCII and as UTF-16LE).
+pub fn find_staging_id(install_path: &Path) -> Option<String> {
+    let mut ids: Vec<String> = Vec::new();
+    let files = autorun_files(install_path);
+    for file in &files {
+        let Ok(handle) = std::fs::File::open(file) else { continue };
+        let mut bytes = Vec::new();
+        if handle.take(MAX_SCAN).read_to_end(&mut bytes).is_err() {
+            continue;
+        }
+        let ascii: String = bytes.iter().map(|&b| if b.is_ascii() { b as char } else { '\0' }).collect();
+        // A UTF-16 string can start on an odd byte of a binary file: read both.
+        let wide = |skip: usize| -> String {
+            bytes[skip.min(bytes.len())..].chunks_exact(2)
+                .map(|c| u16::from_le_bytes([c[0], c[1]]))
+                .map(|u| if u < 0x80 { u as u8 as char } else { '\0' })
+                .collect()
+        };
+        let found = ids_in(&ascii).into_iter().chain(ids_in(&wide(0))).chain(ids_in(&wide(1)));
+        for id in found {
+            if !ids.contains(&id) {
+                ids.push(id);
+            }
+        }
+    }
+    // Say what was found every time (the id is not secret, the key never
+    // goes through here): a skipped key must not fail silently (#10).
+    match (files.len(), ids.len()) {
+        (0, _) => info!("No autorun.dat under __Installer: no staged product key needed"),
+        (n, 0) => warn!("{n} autorun.dat file(s) found, but none names a staging id: no product key staged"),
+        (n, 1) => info!("Staging id '{}' found in {n} autorun.dat file(s)", ids[0]),
+        // Several distinct ids: the key's destination is ambiguous, write none.
+        (n, _) => warn!("{n} autorun.dat file(s) name {} different staging ids ({}): no product key staged", ids.len(), ids.join(", ")),
+    }
+    if ids.len() == 1 { ids.pop() } else { None }
+}
+
+/// `.reg` content for the staging key. The key is validated upstream
+/// (letters, digits, dashes, spaces), so it needs no escaping.
+pub fn staging_reg(id: &str, key: &str) -> String {
+    format!(
+        "Windows Registry Editor Version 5.00\r\n\r\n\
+         [HKEY_CURRENT_USER\\Software\\Electronic Arts\\EA Core\\Staging\\eadm\\eadm\\online_content\\{id}\\ergc]\r\n\
+         @=\"{key}\"\r\n"
+    )
+}
+
+#[cfg(unix)]
+pub async fn write_staging_key(id: &str, key: &crate::core::legacy_keys::LegacyCdKey) -> Result<(), NativeError> {
+    use std::os::unix::fs::OpenOptionsExt;
+    use std::io::Write;
+
+    use crate::{
+        unix::wine::{run_sensitive_wine_command, CommandType},
+        util::native::maxima_dir,
+    };
+
+    let dir = maxima_dir()?.join("temp");
+    std::fs::create_dir_all(&dir)?;
+    let path = dir.join(format!("staging-{}.reg", std::process::id()));
+    let result = async {
+        {
+            let mut file = std::fs::OpenOptions::new()
+                .write(true).create(true).truncate(true).mode(0o600).open(&path)?;
+            file.write_all(staging_reg(id, key.as_secret_str()).as_bytes())?;
+        }
+        let path_str = path.to_str().ok_or_else(|| NativeError::Io(std::io::ErrorKind::InvalidData.into()))?;
+        run_sensitive_wine_command("regedit", Some(vec!["/S", path_str]), None, CommandType::Run).await
+    }.await;
+    let _ = std::fs::remove_file(&path);
+    result
+}
+
+fn installer_log(install_path: &Path) -> Option<PathBuf> {
+    child_named(&child_named(install_path, "__Installer")?, "InstallLog.txt")
+}
+
+/// Size of InstallLog.txt before Touchup runs; only what it adds is read.
+pub fn installer_log_len(install_path: &Path) -> u64 {
+    installer_log(install_path).and_then(|p| p.metadata().ok()).map(|m| m.len()).unwrap_or(0)
+}
+
+/// True when this run's log shows a failed Game Explorer registration and no
+/// other error.
+pub fn game_explorer_only_failure(text: &str) -> bool {
+    // Any case: a failed DirectX setup logs "Error installing DirectX runtime".
+    let errors: Vec<&str> = text.lines().filter(|l| l.to_ascii_lowercase().contains("error")).collect();
+    let explorer = |l: &str| l.contains("IGameExplorer") || l.contains("GDFBinary");
+    text.contains("Failed to install GDF")
+        && !errors.is_empty()
+        && errors.iter().all(|l| explorer(l))
+}
+
+fn new_log_text(install_path: &Path, start: u64) -> Option<String> {
+    let mut file = std::fs::File::open(installer_log(install_path)?).ok()?;
+    let len = file.metadata().ok()?.len();
+    let mut bom = [0u8; 2];
+    let wide = file.read_exact(&mut bom).is_ok() && bom == [0xFF, 0xFE];
+    let start = if start <= len { start } else { 0 };
+    let mut start = start.max(len.saturating_sub(MAX_LOG));
+    if wide {
+        start += start % 2;
+    }
+    file.seek(SeekFrom::Start(start)).ok()?;
+    let mut bytes = Vec::new();
+    file.take(MAX_LOG).read_to_end(&mut bytes).ok()?;
+    Some(decode_log(&bytes, wide))
+}
+
+/// InstallLog.txt is UTF-16LE on the EA installers that write it (each run
+/// appends a new section starting with its own BOM), plain text elsewhere.
+fn decode_log(bytes: &[u8], wide: bool) -> String {
+    if !wide {
+        return String::from_utf8_lossy(bytes).into_owned();
+    }
+    let units: Vec<u16> = bytes.chunks_exact(2).map(|c| u16::from_le_bytes([c[0], c[1]])).collect();
+    String::from_utf16_lossy(&units).replace('\u{feff}', "")
+}
+
+/// Accept Touchup's code 3 when its only error is the Game Explorer
+/// registration; every other failure is returned unchanged.
+pub fn tolerate_game_explorer(
+    outcome: Result<(), NativeError>,
+    install_path: &Path,
+    log_start: u64,
+) -> Result<(), NativeError> {
+    match outcome {
+        Err(NativeError::Wine(WineError::Command { exit, .. }))
+            if exit.code() == Some(3)
+                && new_log_text(install_path, log_start).is_some_and(|t| game_explorer_only_failure(&t)) =>
+        {
+            warn!("Installer could not register the game with Windows Game Explorer (code 3); the game files are installed");
+            Ok(())
+        }
+        other => other,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn staging_id_is_read_from_ascii_and_utf16_autorun() {
+        assert_eq!(ids_in("x\\EA Core\\Staging\\eadm\\eadm\\online_content\\bf2142_deluxe_dd\\ergc"), vec!["bf2142_deluxe_dd"]);
+        let wide: Vec<u8> = "online_content\\game_1\0".encode_utf16().flat_map(|u| u.to_le_bytes()).collect();
+        let text: String = wide.chunks_exact(2).map(|c| u16::from_le_bytes([c[0], c[1]]) as u8 as char).collect();
+        assert_eq!(ids_in(&text), vec!["game_1"]);
+        assert!(ids_in("no staging here").is_empty());
+    }
+
+    #[test]
+    fn several_staging_ids_write_nothing() {
+        let dir = std::env::temp_dir().join(format!("mx-staging-{}", std::process::id()));
+        let disk = dir.join("__Installer").join("DISK1");
+        std::fs::create_dir_all(&disk).unwrap();
+        std::fs::write(disk.join("autorun.dat"), b"online_content\\one\0online_content\\two").unwrap();
+        assert_eq!(find_staging_id(&dir), None);
+        std::fs::write(disk.join("autorun.dat"), b"..online_content\\one\\ergc..").unwrap();
+        assert_eq!(find_staging_id(&dir).as_deref(), Some("one"));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn staging_reg_targets_the_default_value() {
+        let reg = staging_reg("bf2142_deluxe_dd", "AAAA-BBBB");
+        assert!(reg.contains("[HKEY_CURRENT_USER\\Software\\Electronic Arts\\EA Core\\Staging\\eadm\\eadm\\online_content\\bf2142_deluxe_dd\\ergc]"));
+        assert!(reg.contains("@=\"AAAA-BBBB\""));
+    }
+
+    #[test]
+    fn staging_id_is_found_at_odd_utf16_offsets_and_with_slashes() {
+        let dir = std::env::temp_dir().join(format!("mx-staging-odd-{}", std::process::id()));
+        let disk = dir.join("__Installer").join("DISK1");
+        std::fs::create_dir_all(&disk).unwrap();
+        let mut bytes = vec![0x07u8];
+        bytes.extend("Staging\\eadm\\eadm\\online_content\\bf2142_deluxe_dd\\ergc\0".encode_utf16().flat_map(|u| u.to_le_bytes()));
+        std::fs::write(disk.join("autorun.dat"), &bytes).unwrap();
+        assert_eq!(find_staging_id(&dir).as_deref(), Some("bf2142_deluxe_dd"));
+        std::fs::write(disk.join("autorun.dat"), b"eadm/online_content/game_2/ergc").unwrap();
+        assert_eq!(find_staging_id(&dir).as_deref(), Some("game_2"));
+        std::fs::remove_dir_all(&dir).unwrap();
+        assert_eq!(find_staging_id(&dir), None);
+    }
+
+    #[test]
+    fn utf16_install_log_is_decoded() {
+        let run = |text: &str| -> Vec<u8> {
+            let mut b = vec![0xFF, 0xFE];
+            b.extend(text.encode_utf16().flat_map(|u| u.to_le_bytes()));
+            b
+        };
+        let explorer = "IGameExplorer2 for windows 7\r\n\
+            12:57:29  ERROR: Windows IGameExplorer2 is unable to InstallGame (80070005)\r\n\
+            12:57:29  ERROR: Failed to install 'F:\\x\\GDFBinary_en_US.dll' for install path 'F:\\x\\'\r\n\
+            12:57:29  Failed to install GDF\r\n12:57:29  Installer finished with exit code: 3\r\n";
+        // An earlier run, then Touchup's: only what Touchup appended is read.
+        let mut log = run("12:00:00  Error installing DirectX runtime.\r\n12:00:01  Installer finished with exit code: 1\r\n");
+        let start = log.len() as u64;
+        log.extend(run(explorer));
+        let dir = std::env::temp_dir().join(format!("mx-staging-log-{}", std::process::id()));
+        std::fs::create_dir_all(dir.join("__Installer")).unwrap();
+        std::fs::write(dir.join("__Installer").join("InstallLog.txt"), &log).unwrap();
+        let text = new_log_text(&dir, start).unwrap();
+        assert!(!text.contains('\u{feff}'));
+        assert!(game_explorer_only_failure(&text));
+        // The whole file still shows the earlier DirectX failure.
+        assert!(!game_explorer_only_failure(&new_log_text(&dir, 0).unwrap()));
+        // An odd start (never written by Touchup) is realigned, not garbled.
+        assert!(game_explorer_only_failure(&new_log_text(&dir, start + 1).unwrap()));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn only_a_game_explorer_failure_is_tolerated() {
+        let explorer = "IGameExplorer2 for windows 7\n\
+            ERROR: Windows IGameExplorer2 is unable to InstallGame (80070005)\n\
+            ERROR: Failed to install 'F:\\x\\GDFBinary_en_US.dll' for install path 'F:\\x\\'\n\
+            Failed to install GDF\nInstaller finished with exit code: 3\n";
+        assert!(game_explorer_only_failure(explorer));
+        let directx = "Error installing DirectX runtime.\nERROR: something else\nFailed to install GDF\n";
+        assert!(!game_explorer_only_failure(directx));
+        assert!(!game_explorer_only_failure("Installer finished with exit code: 3\n"));
+        assert!(!game_explorer_only_failure(&format!("Error installing DirectX runtime.\n{explorer}")));
+    }
+}
